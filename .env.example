FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-string
PORT=5002

# Local (non-Docker) runs — Postgres on the host
DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5432/postgres

# Docker Compose sets DATABASE_URL itself, using the service name `db`.
# Only POSTGRES_PASSWORD, SECRET_KEY and PORT are read from here.
POSTGRES_PASSWORD=mysecretpassword
