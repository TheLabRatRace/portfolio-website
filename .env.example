FLASK_ENV=production
# REQUIRED in production -- the app refuses to boot without it. Flask signs
# the session cookie with this, so a known value lets anyone forge an admin
# session with no password. Generate your own, never reuse this line:
#
#     python3 -c "import secrets; print('SECRET_KEY=' + secrets.token_urlsafe(48))" >> .env
#
SECRET_KEY=change-me-to-a-long-random-string
PORT=5002

# Local (non-Docker) runs — Postgres on the host
DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5432/postgres

# Docker Compose sets DATABASE_URL itself, using the service name `db`.
# Only POSTGRES_PASSWORD, SECRET_KEY and PORT are read from here.
POSTGRES_PASSWORD=mysecretpassword

# ── AWS RDS ─────────────────────────────────────────────────────────────
# Read only by docker-compose.rds.yml, which is opt-in:
#
#     docker compose -f docker-compose.yml -f docker-compose.rds.yml up -d web
#
# The plain `docker compose up` stays on the local db container, because the
# test suite runs against whatever the web container is wired to.
#
# Two rules this URL has to satisfy or the app refuses to boot in production:
#
#   1. the role is the least-privilege application role, never the RDS master
#      user -- DML on the tables, no CREATE on the database or schema public;
#   2. it ends with sslmode=verify-full and an sslrootcert. `require` encrypts
#      the wire and validates nothing, so whoever answers for that hostname
#      collects the password. The trust store is committed at
#      certs/global-bundle.pem and mounted read-only into the container.
#
RDS_DATABASE_URL=postgresql://portfolio_app:CHANGE-ME@your-instance.REGION.rds.amazonaws.com:5432/portfolio?sslmode=verify-full&sslrootcert=/app/certs/global-bundle.pem

# Master credentials, used by hand for schema loads and grants only. The
# application never connects as this role.
RDS_HOST=your-instance.REGION.rds.amazonaws.com
RDS_USER=postgres
RDS_DB=portfolio
PGPASSWORD=change-me
APP_DB_PASSWORD=change-me

# ── Asset hosting (S3) ──────────────────────────────────────────────────
# Leave S3_BUCKET empty and uploads go to app/static/images/uploads/ and the
# site works with no AWS account at all. Set it and uploads go to the bucket
# and the database stores `s3:<key>` instead of a path.
S3_BUCKET=
S3_REGION=us-east-2

# The keys are NOT set here. boto3 reads AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY from the environment, ~/.aws/credentials, or an
# instance role -- so a credential never has to live in a file this repo
# can see. Export them in your shell, or run `aws configure`.

# Where a visitor's browser fetches objects from. A CloudFront domain, or
# https://<bucket>.s3.<region>.amazonaws.com if the bucket allows anonymous
# reads. Leave empty for a private bucket and each image is served through
# a presigned URL instead -- correct, but uncacheable, so set this in prod.
S3_PUBLIC_BASE_URL=
S3_URL_EXPIRY_SECONDS=3600

# Only set S3_OBJECT_ACL if the bucket still has ACLs enabled. Buckets
# created since 2023 do not, and sending one is an error rather than a
# no-op. Public access is a bucket policy now, not a per-object ACL.
S3_OBJECT_ACL=
