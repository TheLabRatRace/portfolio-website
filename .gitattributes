# Normalise line endings in the repo, check out native on the host.
* text=auto

# Explicitly text, so a diff is a diff and not "binary files differ".
*.py      text diff=python
*.html    text diff=html
*.css     text diff=css
*.js      text
*.sql     text
*.yaml    text
*.yml     text
*.md      text
*.jsx     text

# Explicitly binary, so Git never tries to normalise or merge them.
*.webp    binary
*.png     binary
*.jpg     binary
*.ico     binary
*.woff    binary
*.woff2   binary

# Generated by tools/gen_image_variants.py. Marking it collapses the diff in
# merge requests -- a 400-entry manifest churning is noise, not review material.
app/static/images/variants.json linguist-generated=true

# Keep vendored/legacy source out of the language statistics.
portfolio.jsx linguist-vendored=true
