# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# ── Phase one: the task on its own ───────────────────────────────────────────
# Leave enable_cdn false and the whole domain/TLS/CDN layer is not created. The
# site answers at http://<task-public-ip>:5002, and deploy/scripts/task_ip.sh
# prints that address -- it changes on every deploy.
enable_cdn = false

# Who may reach the task directly. Only read while enable_cdn is false.
# There is no TLS in phase one, so anyone on the network path reads every
# request in the clear. Narrow this to your own address while you are testing:
#   allowed_cidrs = ["203.0.113.4/32"]   # curl ifconfig.me to find yours
allowed_cidrs = ["0.0.0.0/0"]

# ── Phase two: a name and a certificate in front of it ───────────────────────
# Flip enable_cdn to true and set domain_name. This requires a Route 53 public
# hosted zone for the domain -- see the Namecheap section of deploy/README.md
# for the three ways to get there.
domain_name = ""

# "" serves the apex (example.com). "www" would serve www.example.com.
subdomain = ""

# ── Everything else ──────────────────────────────────────────────────────────
# Must match the region the RDS instance is in, or every query pays a
# cross-region round trip.
region = "us-east-2"

# The bucket uploaded images live in. The task's IAM role is granted access to
# it, which is what makes the access-key CSV unnecessary in production.
assets_bucket          = "your-assets-bucket"
assets_public_base_url = ""

# Found in the RDS console under Connectivity & security. Given this, Terraform
# opens 5432 to the task's security group so the instance can stop being
# publicly accessible.
rds_security_group_id = ""

# true is roughly $2.20/month instead of $7.20, in exchange for AWS being
# allowed to reclaim the task on two minutes' notice.
use_spot = false
